# Copie somente as variáveis que faltam para seu .env atual. Não o sobrescreva.
APP_ORIGIN=https://seu-projeto.vercel.app
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública anon/publishable: somente esta pode chegar ao navegador.
SUPABASE_ANON_KEY=
# Chave secreta service_role/secret: apenas nas funções da Vercel.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_GENERATION_TOKEN=
GENERATION_DAILY_BATCHES=10
# Desativadas por padrão. Geração administrativa é a opção recomendada.
ALLOW_PLAY_REPLENISH=false
ALLOW_AI_DB_FALLBACK=false
ALLOW_LEGACY_AI=false
# Configure ao menos um provedor existente:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
